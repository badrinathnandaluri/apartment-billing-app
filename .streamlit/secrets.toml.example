# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → App → Settings → Secrets.
# Never commit the real file (it is in .gitignore).

# Supabase → Connect → "Session pooler" connection string (works over IPv4, unlike the direct host).
db_url = "postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

app_username = "admin"
# Generate with:  python scripts/hash_password.py
app_password_hash = "pbkdf2_sha256$600000$...$..."
